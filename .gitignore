# Claude Code local config. Machine-specific: absolute paths, local ports, and
# the names of whatever else happens to be checked out on this machine. None of
# it is useful to anyone cloning a static site.
.claude/

# Node tooling. The site itself is a single static index.html and needs none of
# this at runtime, so nothing here belongs in the repo.
node_modules/
package.json
package-lock.json

# The design skill's working files. The captures, mocks and build state are
# large and specific to one run, and this repo is the deploy root, so they stay
# out of it; the design system's own records (design.json, the surface briefs)
# are small, durable and tracked.
.impeccable/review/
.impeccable/mocks/
.impeccable/build/
